# ──────────────────────────────────────────────────────────────────────────────
# CA Rohadas — Docker environment variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy to `.env` and fill in values before running:
#   cp .env.docker.example .env
#
# Docker Compose reads `.env` for ${VAR} substitution in docker-compose.yml.
# The backend ALSO reads these at runtime via pydantic Settings (BaseSettings),
# so the same values are passed into the container via the `environment:` block.
#
# ── Generate strong secrets ─────────────────────────────────────────────────
#   python -c "import secrets; print(secrets.token_urlsafe(48))  # JWT_SECRET
#   python -c "import secrets; print(secrets.token_urlsafe(24))"  # CRON_SECRET
# ──────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ca_software

# ── Backend ──
# Set to `production` for a real deployment. The app will refuse to start
# unless JWT_SECRET, CRON_SECRET and AI_API_KEY are set to non-default values.
ENVIRONMENT=development

# Required in production (≥32 random characters)
JWT_SECRET=dev-only-insecure-secret-change-me

# Required in production (≥16 random characters)
CRON_SECRET=dev-cron-secret-change-me

# AI API key (required in production)
AI_API_KEY=

# CORS: set to the frontend URL in production, e.g. https://app.example.com
# Use `["*"]` for local development behind the reverse proxy.
CORS_ORIGINS=*

# Storage: `local` (filesystem) or `vercel_blob` (Vercel Blob)
STORAGE_BACKEND=local

# WhatsApp gateway (http://baileys-gateway:3001 when running in compose)
WHATSAPP_PROVIDER=baileys
WHATSAPP_API_URL=http://baileys-gateway:3001

# Port overrides (optional)
BACKEND_PORT=8000
FRONTEND_PORT=3000
WHATSAPP_PORT=3001
